{
  "mcpServers": {
    "daslang": {
      "command": "/root/daScript/bin/watchdog",
      "args": [
        "--stdio",
        "--name",
        "daslang-mcp",
        "--cwd",
        "/root/wasm3das",
        "--program",
        "/root/daScript/bin/daslang",
        "--",
        "-ignore-manifest",
        "/root/daScript/utils/mcp/main.das"
      ],
      "env": {
        "DAS_LINT_CONFIG_PATH": "/root/wasm3das/.lint_config"
      },
      "defer_loading": false
    },
    "daslang-dap": {
      "command": "/root/daScript/bin/watchdog",
      "args": [
        "--stdio",
        "--name",
        "daslang-dap",
        "--cwd",
        "/root/wasm3das",
        "--program",
        "/root/daScript/bin/daslang",
        "--",
        "/root/daScript/utils/dap/main.das",
        "--",
        "--repo-root",
        "/root/wasm3das",
        "--executable",
        "/root/daScript/bin/daslang"
      ]
    }
  }
}
