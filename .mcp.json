{
  "mcpServers": {
    "daslang": {
      "command": "${DASLANG_ROOT}/bin/daslang",
      "args": [
        "-ignore-manifest",
        "${DASLANG_ROOT}/utils/mcp/main.das"
      ],
      "env": {
        "DAS_LINT_CONFIG_PATH": ".lint_config"
      },
      "defer_loading": false
    },
    "daslang-dap": {
      "command": "python3",
      "args": [
        "${DASLANG_ROOT}/utils/dap/mcp_bridge.py",
        "--repo-root",
        ".",
        "--executable",
        "${DASLANG_ROOT}/bin/daslang"
      ]
    }
  }
}
