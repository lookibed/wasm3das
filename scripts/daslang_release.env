# The pinned daslang toolchain of wasm3das: one official prebuilt release
# bundle from GaijinEntertainment/daScript, used unchanged by the gate, the
# launchers, CI, the release workflow and the editor tooling. daslang is never
# built from source for this project.
#
# scripts/install_daslang.sh downloads the asset for the current platform,
# verifies it against the checksum below and unpacks it into tmp/daslang;
# scripts/gate.sh refuses to run against anything else.
DASLANG_RELEASE=v0.6.4-RC2
DASLANG_RELEASE_REPO=GaijinEntertainment/daScript
DASLANG_RELEASE_VERSION=0.6.4

# sha256 of daslang-bundle-<platform>.zip, from the .sha256 files of the release.
DASLANG_SHA256_linux_x86_64=a93f8ebb0be14a725a19cf64e268688b9849261fded5bd6169729f43413c4c76
DASLANG_SHA256_linux_arm64=ccdf30bf3cc808cc524cd9a94765f80b2e2e2b7e016f35d2ed0c6521fa4d92b0
DASLANG_SHA256_windows_x86_64=de460789f2539436dfdc36ac9ee13868d8d6231cb612487cd3f53fa2e0089402
DASLANG_SHA256_darwin26_arm64=4c8810219f172b6e3adfc9f12628ee851a943c305d3f816cbb00d4781ecb986d
