#!/usr/bin/env bash
# wasm3 command line front end for the Daslang port: the drop-in replacement
# for the C `wasm3` binary that wasm3c/test/run-spec-test.py drives with
# `--exec "<repo>/scripts/wasm3 --repl"`.
#
# Environment:
#   DASLANG_ROOT    required: the checked-out and built daslang at the commit
#                   pinned in scripts/daslang_pin (see README "Install and run")
#   DASLANG         daslang binary (default: $DASLANG_ROOT/bin/daslang)
#   WASM3DAS_JIT    when 1, pass -jit to daslang so the port runs LLVM-compiled
#                   instead of interpreted. The local daslang build ships the
#                   LLVM JIT when built without -DDAS_LLVM_DISABLED=ON; the
#                   same binary serves both modes.
#   WASM3DAS_JIT_ARGS extra daslang JIT switches, whitespace separated, only used
#                   when WASM3DAS_JIT=1 (for example -jit-no-cache, -jit-stack).
#                   These are daslang's own options and go before the `--`.
#   WASM3DAS_JIT_OPTS options of the JIT's command-line schema (dasLLVM
#                   llvm_jit_cli, for example --jit-opt-level=0), whitespace
#                   separated, only used when WASM3DAS_JIT=1. daslang reads
#                   them after the `--`, among the script's arguments, and
#                   app/wasm3.das ignores them; passing them before the `--`
#                   is an "unknown command line option" error.
#                   Since every pointer parameter the port writes through is
#                   `var` (the workaround for upstream #3991), the port is
#                   correct at daslang's default O3; --jit-opt-level=0 is the
#                   control that tells whether that defect is back
#                   (docs/upstream-status.md).
#   WASM3DAS_APP      alternative app entry point (default: app/wasm3.das), so an
#                   experimental copy of the tree can be driven through this
#                   same front end. Used by scripts/bench.sh.
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

# A release bundle names its own compiler through DASLANG (scripts/bundle/wasm3)
# and carries no checkout; a repository run resolves it from DASLANG_ROOT.
if [[ -z "${DASLANG:-}" ]]; then
    : "${DASLANG_ROOT:?set DASLANG_ROOT to your daslang checkout at the pinned commit; see README, Install and run}"
    DASLANG="$DASLANG_ROOT/bin/daslang"
fi

if [[ ! -x "$DASLANG" ]]; then
    echo "wasm3: missing daslang at $DASLANG (build your DASLANG_ROOT checkout)" >&2
    exit 1
fi

# Ops return to the RunLoop dispatcher (m3_exec_defs.das), so only a wasm call
# nests interpreter frames, but the Daslang context stack of app/wasm3.das
# (`options stack`) still needs a native stack a few times larger: with the
# default 8 MiB thread stack an unbounded wasm recursion kills the process
# with SIGSEGV before op_Entry can report `[trap] stack overflow`, which the
# spec suite's assert_exhaustion cases expect. Raise the limit when the shell
# is allowed to.
ulimit -s 262144 2>/dev/null || true

# The daslang CLI consumes --help and -h anywhere in argv, including after the
# `--` separator, and prints its own usage instead of running the script. They
# are forwarded under the alias --wasm3-help, which app/wasm3.das accepts as a
# spelling of main.c's --help.
args=()
for arg in "$@"; do
    case "$arg" in
        --help|-h) args+=("--wasm3-help") ;;
        *)         args+=("$arg") ;;
    esac
done

# Opt-in JIT. Without WASM3DAS_JIT=1 the command line is exactly what it was
# before, so the pinned interpreter path stays untouched.
das_opts=()
jit_opts=()
if [[ "${WASM3DAS_JIT:-}" == "1" ]]; then
    das_opts+=("-jit")
    if [[ -n "${WASM3DAS_JIT_ARGS:-}" ]]; then
        # Deliberately unquoted: the variable carries several switches.
        # shellcheck disable=SC2206
        das_opts+=(${WASM3DAS_JIT_ARGS})
    fi
    if [[ -n "${WASM3DAS_JIT_OPTS:-}" ]]; then
        # shellcheck disable=SC2206
        jit_opts=(${WASM3DAS_JIT_OPTS})
    fi
else
    # The interpreter requires no dynamic module: app/wasm3.das and source/
    # pull in builtin, math, strings, daslib/fio, daslib/strings and
    # daslib/random only. Without this switch daslang still dlopens and
    # registers all 24 dasXxx modules of the release bundle (dasLLVM, dasImgui,
    # dasGlfw, ...) before it starts compiling, which costs ~0.13 s of the
    # ~2 s startup on every single run. The JIT branch above must not set it:
    # -jit needs dasLLVM.
    das_opts+=("-no-dynamic-modules")
fi

app="${WASM3DAS_APP:-$repo_root/app/wasm3.das}"

exec "$DASLANG" "$app" ${das_opts[@]+"${das_opts[@]}"} -- ${jit_opts[@]+"${jit_opts[@]}"} ${args[@]+"${args[@]}"}
