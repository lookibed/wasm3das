-def intrinsic_math_any_float_op1(expr_name : string; g_builder : LLVMOpaqueBuilder?; expr : ExprCallFunc?; arguments : array<LLVMOpaqueValue?>) : LLVMOpaqueValue? {
+// A call written with its module qualifier ("math::sqrt") carries the qualified
+// spelling in expr.name, while an unqualified call to the same builtin carries
+// just "sqrt". Every intrinsic below builds an LLVM intrinsic name out of that
+// string, so the qualified spelling produced "llvm.math::sqrt.f32", which
+// LLVMLookupIntrinsicID answers with id 0 and LLVMGetIntrinsicDeclaration then
+// dereferences - a hard SIGSEGV during codegen. Strip the namespace here.
+def jit_unqualified_name(name : string) : string {
+    let sep = name |> find("::")
+    return sep == -1 ? name : name |> slice(sep + 2)
+}
+
+def intrinsic_math_any_float_op1(expr_name_in : string; g_builder : LLVMOpaqueBuilder?; expr : ExprCallFunc?; arguments : array<LLVMOpaqueValue?>) : LLVMOpaqueValue? {
+    let expr_name = jit_unqualified_name(expr_name_in)
     var sqrt_name = "llvm.{expr_name}.f32"
     assume opType = expr.arguments[0]._type
     if (opType.isFloatOrDouble || (opType.isVectorType && opType.vectorBaseType == Type.tFloat)) {
@@ -1043,6 +1055,12 @@ def intrinsic_math_any_float_op1(expr_name : string; g_builder : LLVMOpaqueBuild
     var args <- [ arguments[0]]
     var argTypes <- [ type_to_llvm_abi_type(expr.arguments[0]._type)]
     let id = LLVMLookupIntrinsicID(sqrt_name)
+    // Id 0 means "no such intrinsic"; LLVMGetIntrinsicDeclaration crashes on it
+    // instead of returning null, so refuse it here.
+    if (id == 0u) {
+        failed_E(expr, "missing intrinsic {sqrt_name}")
+        return null
+    }
     var decl = LLVMGetIntrinsicDeclaration(g_mod, id, argTypes)
     if (decl == null) {
         failed_E(expr, "missing intrinsic {sqrt_name}")
