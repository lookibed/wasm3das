{
  "name": "daslang-lsp",
  "description": "daslang language server (the daslang release bundle pinned in scripts/daslang_release.env) - compiler diagnostics after every edit, plus definition/hover/references/symbols",
  "lspServers": {
    "daslang": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/../../../tmp/daslang/utils/lsp/lsp_supervisor.py"
      ],
      "env": {
        "DAS_LINT_CONFIG_PATH": "${CLAUDE_PLUGIN_ROOT}/../../../.lint_config"
      },
      "extensionToLanguage": {
        ".das": "daslang"
      },
      "initializationOptions": {
        "compiler": "tmp/daslang/bin/daslang",
        "project_root": "."
      }
    }
  }
}
