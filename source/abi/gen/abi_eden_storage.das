/*
    Package eden_storage, version 1: Persistent named blobs (save games, battery RAM, settings) that outlive the instance and the session. The host gives each guest its own namespace; the guest only names blobs inside it. A write replaces the whole blob and is persisted before it returns.

    The host implements EdenStorageHost (every field must be set; abi_link_eden_storage
    refuses a null one) and links it into an instance. Each
    implementation receives the runtime (for AbiBytes access) and the
    instance id (the key of any per-instance state it keeps). To fail
    the guest it calls abi_trap(message) and returns.
*/


let public EDEN_STORAGE_VERSION = 1
let public EDEN_STORAGE_MAX_NAME = 64   // longest blob name in bytes
let public EDEN_STORAGE_MAX_TOTAL_BYTES = 3145728   // all blobs of a namespace together (the Eden host keeps a namespace in one engine storage of at most 5 MB, base64-encoded)
let public EDEN_STORAGE_OK = 0   // success
let public EDEN_STORAGE_ERR_NOT_FOUND = -1   // no blob with this name
let public EDEN_STORAGE_ERR_RANGE = -2   // offset is negative or past the end of the blob
let public EDEN_STORAGE_ERR_FULL = -3   // the write would take the namespace past MAX_TOTAL_BYTES
let public EDEN_STORAGE_ERR_IO = -4   // the host could not persist the change (engine storage limits or errors); the previous content is kept
let public EDEN_STORAGE_ERR_NAME = -5   // the name is empty or longer than MAX_NAME


struct EdenStorageHost {
    // Size of the blob in bytes, or ERR_NOT_FOUND / ERR_NAME.
    size : function<(var rt : M3Runtime; inst : int; name : string) : int>
    // Copies bytes [offset, offset + cap) of the blob (fewer at its end) into
    // dst. Returns the number of bytes copied, or ERR_NOT_FOUND / ERR_RANGE /
    // ERR_NAME.
    read : function<(var rt : M3Runtime; inst : int; name : string; offset : int; dst : AbiBytes) : int>
    // Replaces the blob with data (creating it) and persists it. Returns OK or
    // ERR_FULL / ERR_IO / ERR_NAME.
    write : function<(var rt : M3Runtime; inst : int; name : string; data : AbiBytes) : int>
    // Deletes the blob and persists the change. Returns OK or ERR_NOT_FOUND /
    // ERR_IO / ERR_NAME.
    remove : function<(var rt : M3Runtime; inst : int; name : string) : int>
}


