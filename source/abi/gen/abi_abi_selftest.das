    }
    let version = abi_eden_abi_version(inst)
    if (!empty(inst.error)) {
        return inst.error
    }
    if (version != 1) {
        return "{inst.name}: built for world version {version}, the host supports eden_game version 1"
    }
    inst.world = "abi_selftest"
    return m3Err_none
