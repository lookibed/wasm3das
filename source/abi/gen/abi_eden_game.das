// Restores a snapshot made by eden_state_save of the same guest build; 0 =
// ok. Optional export: check abi_has_export first.
// On failure returns 0 and inst.error says why.
def public abi_eden_state_load(var inst : AbiInstance; a_snapshot : array<uint8>) : int {
