    push(placed, p_snapshot)
    push(args, m3_bits_from_i32(p_snapshot))
    push(args, m3_bits_from_i32(length(a_snapshot)))
    var inscope rets : array<uint64>
    let ok = abi_call(inst, "eden_state_load", args, rets)
    for (q in placed) {
        abi_free_guest(inst, q)
    }
    if (!ok || length(rets) < 1) {
        return 0
    }
    return m3_bits_to_i32(rets[0])
}


// imports resolved and in the world, required exports present, version
def public abi_bind_eden_game(var inst : AbiInstance) : M3Result {
    if (!inst.alive) {
        return "{inst.name}: bind eden_game: the instance is not alive"
    }
    var packages : array<string>
    push(packages, "eden_core")
    push(packages, "eden_asset")
    push(packages, "eden_video")
    push(packages, "eden_input")
    push(packages, "eden_audio")
    push(packages, "eden_storage")
    var r = abi_check_imports(inst, "eden_game", packages)
    if (r != m3Err_none) {
        return r
    }
    var required : array<string>
    var optional : array<string>
    push(required, "eden_abi_version")
    push(required, "eden_alloc")
    push(required, "eden_free")
    push(required, "eden_init")
    push(required, "eden_step")
    push(required, "eden_shutdown")
    push(optional, "eden_state_size")
    push(optional, "eden_state_save")
    push(optional, "eden_state_load")
    r = abi_bind_exports(inst, required, optional)
    if (r != m3Err_none) {
        return r
    }
    let version = abi_eden_abi_version(inst)
    if (!empty(inst.error)) {
        return inst.error
    }
    if (version != 1) {
        return "{inst.name}: built for world version {version}, the host supports eden_game version 1"
    }
    inst.world = "eden_game"
    return m3Err_none
}
