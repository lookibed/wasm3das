def private abi_unlink_abi_test(id : int) {
    g_impls |> erase(id)
}


// links every import of abi_test the guest has; refuses an implementation
// with a null function
def public abi_link_abi_test(var inst : AbiInstance; impl : AbiTestHost) : M3Result {
    if (!inst.alive) {
        return "{inst.name}: link abi_test: the instance is not alive"
    }
    if (abi_is_linked(inst, "abi_test") && !inst.relinking) {
        return "{inst.name}: abi_test is already linked"
    }
    if (!abi_is_linked(inst, "abi_test") && inst.relinking) {
        return "{inst.name}: relink of abi_test, which was not linked before"
    }
    if (impl.echo_i32 == null) {
        return "{inst.name}: abi_test.echo_i32 has no host implementation"
    }
    if (impl.echo_i64 == null) {
        return "{inst.name}: abi_test.echo_i64 has no host implementation"
    }
    if (impl.echo_f32 == null) {
        return "{inst.name}: abi_test.echo_f32 has no host implementation"
    }
    if (impl.echo_f64 == null) {
        return "{inst.name}: abi_test.echo_f64 has no host implementation"
    }
    if (impl.negate == null) {
        return "{inst.name}: abi_test.negate has no host implementation"
    }
    if (impl.mix == null) {
        return "{inst.name}: abi_test.mix has no host implementation"
    }
    if (impl.str_len == null) {
        return "{inst.name}: abi_test.str_len has no host implementation"
    }
    if (impl.bytes_sum == null) {
        return "{inst.name}: abi_test.bytes_sum has no host implementation"
    }
    if (impl.fill == null) {
        return "{inst.name}: abi_test.fill has no host implementation"
    }
    if (impl.make_handle == null) {
        return "{inst.name}: abi_test.make_handle has no host implementation"
    }
    if (impl.handle_value == null) {
        return "{inst.name}: abi_test.handle_value has no host implementation"
    }
    if (impl.fail == null) {
        return "{inst.name}: abi_test.fail has no host implementation"
    }
    if (impl.record == null) {
        return "{inst.name}: abi_test.record has no host implementation"
    }
    g_impls[inst.id] = impl
    abi_register_package(inst, "abi_test", @@abi_unlink_abi_test)
    var r : M3Result = m3Err_none
    r = abi_link_one(inst, "abi_test", "echo_i32", "i(i)", @@abi_imp_abi_test_echo_i32)
    if (r != m3Err_none) {
        return r
    }
    r = abi_link_one(inst, "abi_test", "echo_i64", "I(I)", @@abi_imp_abi_test_echo_i64)
    if (r != m3Err_none) {
        return r
    }
    r = abi_link_one(inst, "abi_test", "echo_f32", "f(f)", @@abi_imp_abi_test_echo_f32)
    if (r != m3Err_none) {
        return r
    }
    r = abi_link_one(inst, "abi_test", "echo_f64", "F(F)", @@abi_imp_abi_test_echo_f64)
    if (r != m3Err_none) {
        return r
    }
    r = abi_link_one(inst, "abi_test", "negate", "i(i)", @@abi_imp_abi_test_negate)
    if (r != m3Err_none) {
        return r
    }
    r = abi_link_one(inst, "abi_test", "mix", "F(iIfFi)", @@abi_imp_abi_test_mix)
    if (r != m3Err_none) {
        return r
    }
    r = abi_link_one(inst, "abi_test", "str_len", "i(ii)", @@abi_imp_abi_test_str_len)
    if (r != m3Err_none) {
        return r
    }
    r = abi_link_one(inst, "abi_test", "bytes_sum", "i(ii)", @@abi_imp_abi_test_bytes_sum)
    if (r != m3Err_none) {
        return r
    }
    r = abi_link_one(inst, "abi_test", "fill", "i(iii)", @@abi_imp_abi_test_fill)
    if (r != m3Err_none) {
        return r
    }
    r = abi_link_one(inst, "abi_test", "make_handle", "i(i)", @@abi_imp_abi_test_make_handle)
    if (r != m3Err_none) {
        return r
    }
    r = abi_link_one(inst, "abi_test", "handle_value", "i(i)", @@abi_imp_abi_test_handle_value)
    if (r != m3Err_none) {
        return r
    }
    r = abi_link_one(inst, "abi_test", "fail", "v()", @@abi_imp_abi_test_fail)
    if (r != m3Err_none) {
        return r
    }
    r = abi_link_one(inst, "abi_test", "record", "v(ii)", @@abi_imp_abi_test_record)
    if (r != m3Err_none) {
        return r
    }
    return m3Err_none
}
