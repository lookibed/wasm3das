module abi_abi_test shared public

require modules/wasm3das/source/abi/abi_runtime public
require strings


/*
    Package abi_test, version 1: Test-only package: one import per ABI type, used by the self-test guest to prove marshalling in both directions. Never offered to a real guest.

    The host implements AbiTestHost (every field must be set; abi_link_abi_test
    refuses a null one) and links it into an instance. Each
    implementation receives the runtime (for AbiBytes access) and the
    instance id (the key of any per-instance state it keeps). To fail
    the guest it calls abi_trap(message) and returns.
*/


let public ABI_TEST_VERSION = 1
let public ABI_TEST_MAGIC = 1234567   // a value both sides know


struct AbiTestHost {
    // Returns v.
    echo_i32 : function<(var rt : M3Runtime; inst : int; v : int) : int>
    // Returns v.
    echo_i64 : function<(var rt : M3Runtime; inst : int; v : int64) : int64>
    // Returns v.
    echo_f32 : function<(var rt : M3Runtime; inst : int; v : float) : float>
    // Returns v.
    echo_f64 : function<(var rt : M3Runtime; inst : int; v : double) : double>
    // Returns !v.
    negate : function<(var rt : M3Runtime; inst : int; v : bool) : bool>
    // Returns a + b + c + d + (e ? 1 : 0) as f64: arguments of every scalar type
    // in one call.
    mix : function<(var rt : M3Runtime; inst : int; a : int; b : int64; c : float; d : double; e : bool) : double>
    // Returns the byte length of s as the host received it.
    str_len : function<(var rt : M3Runtime; inst : int; s : string) : int>
    // Returns the sum of the bytes of b.
    bytes_sum : function<(var rt : M3Runtime; inst : int; b : AbiBytes) : int>
    // Writes byte i = (seed + i) & 255 for every i < cap of dst; returns cap.
    fill : function<(var rt : M3Runtime; inst : int; dst : AbiBytes; seed : int) : int>
    // Creates a host object holding v; returns its handle.
    make_handle : function<(var rt : M3Runtime; inst : int; v : int) : int>
    // Value of the host object, or -1 for a bad handle.
    handle_value : function<(var rt : M3Runtime; inst : int; h : int) : int>
    // Always traps with the message `requested`.
    fail : function<(var rt : M3Runtime; inst : int) : void>
    // Appends the string to the host's call log (the host test reads it).
    record : function<(var rt : M3Runtime; inst : int; s : string) : void>
}


var private g_impls : table<int; AbiTestHost>


// abi_test.echo_i32 i(i)
def public abi_imp_abi_test_echo_i32(var rt : M3Runtime; ctx : M3ImportContext; sp : int) : M3Result {
    var f = m3ApiFrame(sp)
    let raw_return = m3ApiReturnType(f)
    let a_v = m3ApiGetArg_i32(rt, f)
    let id = m3_GetUserData(rt)
    var impl = AbiTestHost()
    var found = false
    g_impls |> get(id) $(v) {
        impl = v
        found = true
    }
    if (!found) {
        return abi_trap_message("abi_test", "echo_i32", "no implementation for instance {id}")
    }
    let value = invoke(impl.echo_i32, rt, id, a_v)
    let trap = abi_take_trap()
    if (!empty(trap)) {
        return abi_trap_message("abi_test", "echo_i32", trap)
    }
    m3ApiReturn_i32(rt, raw_return, value)
    return m3Err_none
}


