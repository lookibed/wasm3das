let public EDEN_INPUT_MAX_SCANCODE = 255   // largest scan code key_down accepts


struct EdenInputHost {
    // Held buttons of pad `pad` (0 = the first player) as a BUTTON_* mask; 0 for
    // a pad that does not exist.
    buttons : function<(var rt : M3Runtime; inst : int; pad : int) : int>
