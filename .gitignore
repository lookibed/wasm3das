# Local Daslang toolchain and downloaded utilities
/tmp/
/tools/

# Filesystem metadata copied from Windows downloads
*Zone.Identifier

# Daslang generated artifacts: the JIT writes its cache into the working
# directory of whatever run used it (the repository root, wasm3c/test for the
# WASI driver, tmp/spec/run for the spec driver), so the pattern is unanchored
.jitted_scripts/
*.aot.cpp
*.aot.h

# Editor and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# EdenSpark editor sidecars: the editor imports every image/text file it
# finds in the project tree (including wasm3c/) and writes a .meta next to it
*.meta

# Session-local LSP/MCP wiring (machine-specific absolute paths)
/opencode.json

# Machine-local shell environment of the checkout (DASLANG_ROOT and friends);
# Claude Code sessions take the same values from .claude/settings.local.json
/.env

# Machine-local fixtures (commercial ROMs and other data that must not be
# committed): scripts/eden/install_host.sh installs them as project assets
/fixtures.local.txt

# Diagnostic and benchmark scratch data
/logs/
# libhv (the daslang MCP server's HTTP client) logs failed daslang-live
# connections into the working directory
/libhv.*.log
/benchmarks/tmp/
__pycache__/

# Agent worktrees (Claude Code `isolation: worktree`) live inside the checkout
/.claude/worktrees/

# Legacy Daslang demo project retained locally, unrelated to the Wasm3 port
/demo_*.das
/main.das
/lib/
/run.sh
/Текстовый документ.txt

# Agent session transcripts and raw model logs: keep them out of the port history
/codex-session-*.md
/notes/codex-session-*.md
/notes/wasm3das_*-flash-*.md
