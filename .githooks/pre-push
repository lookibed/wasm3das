#!/usr/bin/env bash
set -euo pipefail

# Local form of the CI quality gate. The gate is defined once in
# scripts/gate.sh; this hook runs it when the pushed commits touch any of its
# inputs. The path filter is the one CI applies
# (.github/workflows/daslang-quality.yml, "Decide whether the gate has
# anything to check"), so a docs-only push is not held for ten minutes
# locally only to be skipped in CI, and a branch deletion runs nothing. The
# gate needs DASLANG_ROOT (the daslang checkout at the commit pinned in
# scripts/daslang_pin, built in place; see README, Install and run); a push
# that touches gate inputs without it is refused with the instruction.
# The tree being pushed, not the tree the hook file lives in: core.hooksPath
# is absolute, so from a git worktree the hook's own directory names the
# main checkout, while git runs the hook at the top of the worktree.
repo_root="$(git rev-parse --show-toplevel)"

gate_inputs='^(source/|tests/integration/|tests/host_test/|app/|scripts/|\.githooks/|\.github/workflows/|\.lint_config$|PORTING_MANIFEST\.md$)'
zero='0000000000000000000000000000000000000000'

# git feeds one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
pushes=0
needs_gate=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "${local_ref:-}" ]] && continue
    if [[ "$local_sha" == "$zero" ]]; then
        echo "pre-push: deleting $remote_ref, nothing to check"
        continue
    fi
    pushes=$((pushes + 1))
    # The commits the remote does not have yet: since the remote tip when it
    # exists locally, otherwise since the merge base with origin/main. When
    # neither can be determined, run the gate.
    if [[ "$remote_sha" != "$zero" ]] && git -C "$repo_root" cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base="$remote_sha"
    else
        base="$(git -C "$repo_root" merge-base "$local_sha" origin/main 2>/dev/null || true)"
    fi
    if [[ -z "$base" ]]; then
        echo "pre-push: cannot determine the pushed range for $local_ref; running the gate"
        needs_gate=1
        continue
    fi
    if git -C "$repo_root" diff --name-only "$base" "$local_sha" -- | grep -Eq "$gate_inputs"; then
        needs_gate=1
    else
        echo "pre-push: $local_ref changes no gate input since ${base:0:7}; gate skipped (CI skips it the same way)"
    fi
done

if (( pushes == 0 || needs_gate == 0 )); then
    exit 0
fi

if [[ -z "${DASLANG_ROOT:-}" ]]; then
    echo "pre-push: DASLANG_ROOT is not set and the pushed commits touch gate inputs." >&2
    echo "  Point it at the daslang checkout of the commit pinned in scripts/daslang_pin," >&2
    echo "  built in place (README, Install and run), and push again:" >&2
    echo "    export DASLANG_ROOT=/path/to/your/daScript" >&2
    exit 1
fi
export DASLANG_ROOT
export DASLANG="${DASLANG:-$DASLANG_ROOT/bin/daslang}"

echo "pre-push: running scripts/gate.sh"
"$repo_root/scripts/gate.sh"
echo "pre-push: Daslang quality gate passed"
