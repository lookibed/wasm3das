#!/usr/bin/env bash
set -euo pipefail

hook_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$hook_dir/.." && pwd)"
toolchain_root="$repo_root/tmp/daslang-toolchain"

if [[ ! -x "$toolchain_root/bin/daslang" ]]; then
    echo "pre-push: missing pinned Daslang toolchain at $toolchain_root" >&2
    exit 1
fi

daslang="$toolchain_root/bin/daslang"

cd "$repo_root"

echo "pre-push: compiler diagnostics"
while IFS= read -r file; do
    "$daslang" -compile-only "$file" >/dev/null
done < <(find source tests -type f -name '*.das' -print | sort)

echo "pre-push: paranoid lint"
"$daslang" "$toolchain_root/utils/lint/main.das" -- --paranoid-only source tests

echo "pre-push: performance lint"
"$daslang" "$toolchain_root/utils/lint/main.das" -- --perf-only source tests

echo "pre-push: style lint"
"$daslang" "$toolchain_root/utils/lint/main.das" -- --style-only source tests

echo "pre-push: project tests"
"$daslang" "$toolchain_root/dastest/dastest.das" -- --test tests

echo "pre-push: Daslang quality gate passed"
